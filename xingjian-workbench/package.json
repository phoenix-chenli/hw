    "check": "npm test && npm run build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "lucide-react": "0.468.0",
    "playwright-core": "1.61.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "4.5.0",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  }
}
