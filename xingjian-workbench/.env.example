# 行简研学当前仍为本机单用户服务；不要将本机服务直接暴露到公网。
XINGJIAN_PORT=8787
# 可选：仓库以外的绝对路径；不填时使用 .runtime/workspace.json。
# XINGJIAN_DATA_FILE=
# PDF 复用现有 Chrome；预配置 CI 可选择 chromium，不自动下载浏览器。
# XINGJIAN_PDF_BROWSER=chrome

# AgentArts 默认关闭，不自动调用，不自动重试，不需要安装原生 SDK。
# 本轮只完成适配与合成测试，尚未开通账号、发布应用或验证真实链路。
# 开通后先阅读 docs/AGENTARTS-WORKFLOW.md；仅在本地 .env 中填写密钥。
# 需要 enabled=true + 以下必填配置 + 显式正整数次数上限 + 页面本次授权，才允许发送。
XINGJIAN_AGENTARTS_ENABLED=false
# 从自己已发布工作流的调用路径复制完整 HTTPS URL，路径必须精确为：
# /runtimes/{XINGJIAN_AGENTARTS_RUNTIME_NAME}/invocations
# XINGJIAN_AGENTARTS_INVOKE_URL=
# XINGJIAN_AGENTARTS_RUNTIME_NAME=
# 仅填 API Key 本身，不包含 Bearer 前缀；不得提交到 GitHub 或发在聊天中。
# XINGJIAN_AGENTARTS_API_KEY=
# 必须自行设置显式正整数（1–999999），不设则不发起请求。
# 工作区持久化计数按派发前标记保守累计，包含失败/中断的尝试，重启不清零；它不是人民币额度。
# XINGJIAN_AGENTARTS_MAX_CALLS=
# 默认 30000，范围 1–60000 毫秒；超时只停止本地等待，不能保证停止云端计费。
# XINGJIAN_AGENTARTS_TIMEOUT_MS=30000
# 可选：人工填写的部署版本标签，不代表平台返回或验证的实际应用版本。
# XINGJIAN_AGENTARTS_APPLICATION_VERSION=
